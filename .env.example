# 中转站配置只放在服务端，不要提交真实密钥。
# 部署到公网时必须设置一段足够长、随机且仅自己知道的访问令牌。
AMID_ACCESS_TOKEN=replace-with-a-long-random-private-token

# 本地默认使用 .data；Railway 挂载卷后会自动读取 RAILWAY_VOLUME_MOUNT_PATH。
# AMID_DATA_DIR=/app/.data

LLM_BASE_URL=https://your-relay.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=claude-sonnet
LLM_PROTOCOL=openai

# ElevenLabs 语音通话：密钥只放服务端，不要写进 public 或浏览器 localStorage。
ELEVENLABS_API_KEY=replace-me
ELEVENLABS_VOICE_ID=replace-with-your-voice-id
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
PORT=4173
HOST=0.0.0.0
